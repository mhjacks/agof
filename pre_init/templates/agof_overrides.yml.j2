---
aap_entitled: {{ aap_entitled | string | lower }}

agof_controller_config_dir: "{{ agof_controller_config_dir }}"

admin_user: admin
admin_password: "{{ admin_password }}"

aap_hostname: "{{ ansible_host }}"
aap_validate_certs: false

agof_cac_repo: "{{ agof_cac_repo | default(agof_iac_repo) }}"
agof_cac_repo_version: "{{ agof_cac_repo_version | default(agof_iac_repo_version | default('main')) }}"
agof_iac_repo: "{{ agof_cac_repo | default(agof_iac_repo) }}"
agof_iac_repo_version: "{{ agof_cac_repo_version | default(agof_iac_repo_version | default('main')) }}"

{% if agof_config_repo_https_token_vault is defined and agof_config_repo_https_token_vault | length > 0 %}
agof_config_repo_https_token_vault: "{{ agof_config_repo_https_token_vault }}"
{% endif %}
{% if agof_config_repo_https_password_vault is defined and agof_config_repo_https_password_vault | length > 0 %}
agof_config_repo_https_password_vault: "{{ agof_config_repo_https_password_vault }}"
{% endif %}
{% if agof_config_repo_https_username is defined and agof_config_repo_https_username | length > 0 %}
agof_config_repo_https_username: "{{ agof_config_repo_https_username }}"
{% endif %}

automation_hub_token_vault: "{{ automation_hub_token_vault }}"

controller_license_src_file: "{{ manifest_file_ref }}"
manifest_content: "{{ lookup('file', manifest_file_ref) | b64encode }}"

secrets: {{ secrets | to_json }}

helm_values: {{ helm_values | to_json }}
