{# Target AAP minor release for version-specific inventory variables #}
{% set _aap_ver = containerized_installer_version | default('2.7') %}
# Ansible Automation Platform {{ _aap_ver }} containerized all-in-one inventory
# This inventory expects to be run from the host where AAP will be installed.
# Consult the AAP {{ _aap_ver }} documentation for optional variables and hardware requirements.

# Platform gateway
# -----------------------------------------------------
[automationgateway]
{{ controller_fqdn }}

# Automation controller
# -----------------------------------------------------
[automationcontroller]
{{ controller_fqdn }}

{% if automation_hub %}
# Automation hub
# -----------------------------------------------------
[automationhub]
{{ controller_fqdn }}
{% endif %}

{% if eda %}
# Event-Driven Ansible controller
# -----------------------------------------------------
[automationeda]
{{ controller_fqdn }}
{% endif %}

{% if _aap_ver is version('2.7', '>=') %}
# Metrics service (required in AAP 2.7 when automation controller is installed)
# -----------------------------------------------------
[automationmetrics]
{{ controller_fqdn }}
{% endif %}

# Database
# -----------------------------------------------------
[database]
{{ controller_fqdn }}

[all:vars]
ansible_connection=local
redis_mode=standalone

# Common variables
# -----------------------------------------------------
postgresql_admin_username={{ postgresql_admin_username }}
postgresql_admin_password={{ postgresql_admin_password }}
registry_username={{ registry_username }}
registry_password={{ registry_password }}
{% if _aap_ver is version('2.6', '>=') %}
de_extra_images={{ de_extra_images | to_json }}
ee_extra_images={{ ee_extra_images | to_json }}
{% endif %}

# Platform gateway
# -----------------------------------------------------
gateway_admin_password={{ gateway_admin_password }}
gateway_pg_host={{ controller_fqdn }}
gateway_pg_password={{ gateway_pg_password }}

# Automation controller
# -----------------------------------------------------
controller_admin_password={{ controller_admin_password }}
controller_pg_host={{ controller_fqdn }}
controller_pg_password={{ controller_pg_password }}
{% if _aap_ver is version('2.7', '>=') %}
controller_percent_memory_capacity={{ controller_percent_memory_capacity }}
{% endif %}
controller_postinstall={{ controller_postinstall | lower }}
controller_license_file={{ controller_license_file }}
controller_postinstall_dir={{ controller_postinstall_dir }}
controller_postinstall_repo_url={{ controller_postinstall_repo_url }}
controller_postinstall_repo_ref={{ controller_postinstall_repo_ref }}

{% if automation_hub %}
# Automation hub
# -----------------------------------------------------
hub_admin_password={{ hub_admin_password }}
hub_pg_host={{ controller_fqdn }}
hub_pg_password={{ hub_pg_password }}
{% if _aap_ver is version('2.7', '>=') %}
hub_seed_collections={{ hub_seed_collections | lower }}
{% endif %}
hub_postinstall={{ hub_postinstall | lower }}
hub_postinstall_dir={{ hub_postinstall_dir }}
hub_postinstall_repo_url={{ hub_postinstall_repo_url }}
hub_postinstall_repo_ref={{ hub_postinstall_repo_ref }}
hub_workers={{ hub_workers }}
hub_collection_signing={{ hub_collection_signing | lower }}
hub_collection_signing_key={{ hub_collection_signing_key }}
hub_container_signing={{ hub_container_signing | lower }}
hub_container_signing_key={{ hub_container_signing_key }}
{% endif %}

{% if eda %}
# Event-Driven Ansible controller
# -----------------------------------------------------
eda_admin_password={{ eda_admin_password }}
eda_pg_host={{ controller_fqdn }}
eda_pg_password={{ eda_pg_password }}
eda_workers={{ eda_workers }}
eda_activation_workers={{ eda_activation_workers }}
{% endif %}

{% if _aap_ver is version('2.7', '>=') %}
# Metrics service
# -----------------------------------------------------
automationmetrics_pg_host={{ automationmetrics_pg_host }}
automationmetrics_pg_password={{ automationmetrics_pg_password }}
automationmetrics_controller_read_pg_host={{ automationmetrics_controller_read_pg_host }}
automationmetrics_controller_read_pg_password={{ automationmetrics_controller_read_pg_password }}
{% endif %}
